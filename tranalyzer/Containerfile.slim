# Slim variant of Containerfile: identical tranalyzer configuration, but download,
# configure, build and clean-up happen in ONE layer so the image stays small.
FROM ubuntu:24.04
ARG DEBIAN_FRONTEND=noninteractive
ENV T2HOME="/t2-src" FDURLIMIT="180" ADD_FDURLIMIT_SUFFIX="false"
SHELL ["/bin/bash", "-c"]
RUN apt-get -y update && apt-get install -y --no-install-recommends \
        ca-certificates less pkg-config wget autoconf autoconf-archive automake \
        libbsd-dev libpcap-dev libreadline-dev libtool make meson zlib1g-dev gawk bzip2 python3 \
    && apt-get -y autoremove && apt-get clean && rm -rf /var/lib/apt/lists/* /var/cache/apt/*
RUN wget --no-verbose --trust-server-names --no-check-certificate https://tranalyzer.com/download/tranalyzer/latest \
    && mkdir -p "$T2HOME" && tar xzf tranalyzer2-*.tar.gz -C /tmp/ && rm tranalyzer2-*.tar.gz \
    && mv /tmp/tranalyzer2-*/* "$T2HOME" \
    && "$T2HOME"/scripts/t2conf/t2conf tranalyzer2 -D PACKETLENGTH=1 -D FDURLIMIT="$FDURLIMIT" -D FLOW_TIMEOUT=65 -D FDLSFINDEX=0 \
    && "$T2HOME"/scripts/t2conf/t2conf basicFlow -D BFO_MAC=0 -D BFO_ETHERTYPE=0 -D BFO_VLAN=0 -D BFO_SUBNET_TEST=0 -D BFO_SUBNET_ORG=0 -D BFO_MAX_HDRDESC=0 \
    && "$T2HOME"/scripts/t2conf/t2conf basicStats -D BS_PAD=0 -D BS_REV_CNT=0 -D BS_AGGR_CNT=0 -D BS_VAR=1 -D BS_SK=1 \
    && "$T2HOME"/scripts/t2conf/t2conf tcpFlags -D RTT_ESTIMATE=0 -D IPCHECKSUM=0 -D WINDOWSIZE=0 -D WINMIN=0 -D SEQ_ACK_NUM=0 -D FRAG_ANALYZE=0 -D NAT_BT_EST=0 -D SCAN_DETECTOR=0 -D MPTCP=0 -D TCPJA4T=0 -D TCPFLGCNT=1 \
    && "$T2HOME"/scripts/t2conf/t2conf txtSink -D TFS_FLOWS_TXT_SUFFIX=".csv" \
    && "$T2HOME"/autogen.sh -y tranalyzer2 basicFlow basicStats tcpFlags txtSink \
    && "$T2HOME"/scripts/t2conf/t2conf tranalyzer2 -G FDURLIMIT -G FLOW_TIMEOUT -G PACKETLENGTH > /t2config.txt \
    && ls -la "$T2HOME"/tranalyzer2/build/tranalyzer \
    && rm -rf "$T2HOME"/utils/subnet "$T2HOME"/doc "$T2HOME"/tests \
    && find "$T2HOME" -name "*.o" -delete
RUN mkdir -p /sources /data /result
COPY ./sources /sources
WORKDIR /data
CMD bash /sources/export_all.sh
